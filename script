Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo_raw = Image("logo.png");
pill_raw = Image("pill.png");
mask_raw = Image("mask.png");

logo_scale = (screen_h * 0.25) / logo_raw.GetHeight();
logo_img = logo_raw.Scale(Math.Int(logo_raw.GetWidth() * logo_scale), Math.Int(logo_raw.GetHeight() * logo_scale));

bar_scale = (logo_img.GetWidth() * 0.70) / pill_raw.GetWidth();
pill_img = pill_raw.Scale(Math.Int(pill_raw.GetWidth() * bar_scale), Math.Int(pill_raw.GetHeight() * bar_scale));
mask_img = mask_raw.Scale(Math.Int(mask_raw.GetWidth() * bar_scale), Math.Int(mask_raw.GetHeight() * bar_scale));

logo_sprite = Sprite(logo_img);
gap = Math.Int(screen_h * 0.05);
logo_sprite.SetPosition((screen_w / 2) - (logo_img.GetWidth() / 2), (screen_h / 2) - (logo_img.GetHeight() / 2) - gap, 10);

pill_sprite = Sprite(pill_img);
mask_sprite = Sprite(mask_img);

pill_x = (screen_w / 2) - (pill_img.GetWidth() / 2);
pill_y = (screen_h / 2) + (logo_img.GetHeight() / 2) + gap;
pill_sprite.SetPosition(pill_x, pill_y, 10);

mask_start_x = pill_x - (mask_img.GetWidth() - pill_img.GetWidth());
mask_sprite.SetPosition(mask_start_x, pill_y, 20);

max_shift = pill_img.GetWidth();
mode = Plymouth.GetMode();

fun progress_callback(duration, progress) {
    if (mode == "shutdown" || mode == "reboot") {
        draw_progress = 1.0 - progress;
    } else {
        draw_progress = progress;
    }
    mask_sprite.SetX(mask_start_x + Math.Int(draw_progress * max_shift));
}

Plymouth.SetBootProgressFunction(progress_callback);
